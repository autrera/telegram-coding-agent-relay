# ==============================================================================
# Telegram Coding Agent Relay Configuration
# ==============================================================================

# --- Telegram Bot Credentials ---
# The bot token provided by @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIjKlMnOpQrStUvWxYz

# Comma-separated list of allowed Telegram User IDs (security whitelist)
# To find your ID, you can message @userinfobot on Telegram
ALLOWED_USER_IDS=123456789

# --- Working Directory ---
# The directory where commands will be executed.
# Supports '~' for home directory or absolute paths.
# Examples:
#   Windows: C:\Users\MadGamer\Projects
#   Linux/macOS: /home/user/projects or ~/projects
WORKING_DIR=C:\Users\MadGamer\Projects

# --- Agent Command Templates (REQUIRED) ---
# {prompt} will be substituted with the user's message/prompt.
# The prompt is also exported as the RELAY_PROMPT environment variable.
#
# Examples for popular coding harnesses:
#
# 1) OpenCode (opencode):
# CONTINUE_COMMAND=opencode run -c --auto "{prompt}"
# NEW_COMMAND=opencode run --auto "{prompt}"
#
# 2) Pi (@earendil-works/pi-coding-agent):
# CONTINUE_COMMAND=pi -c -p "{prompt}" -a
# NEW_COMMAND=pi -p "{prompt}" -a
#
# 3) Claude Code (claude):
# CONTINUE_COMMAND=claude -c -p "{prompt}" --dangerously-skip-permissions
# NEW_COMMAND=claude -p "{prompt}" --dangerously-skip-permissions
#
# 4) Google Antigravity (agy):
# CONTINUE_COMMAND=agy -c -p "{prompt}" --dangerously-skip-permissions
# NEW_COMMAND=agy -p "{prompt}" --dangerously-skip-permissions
#
# 5) Custom Script / Runner:
# CONTINUE_COMMAND=python my_agent.py --continue --prompt "{prompt}"
# NEW_COMMAND=python my_agent.py --new --prompt "{prompt}"

# Active configuration (uncomment or set your preferred harness):
CONTINUE_COMMAND=opencode run -c --auto "{prompt}"
NEW_COMMAND=opencode run --auto "{prompt}"

# --- Advanced Options ---
# Timeout for command execution in seconds (default: 600 = 10 minutes)
# Set to 0 to disable the timeout entirely (use /cancel to abort long tasks)
COMMAND_TIMEOUT_SECONDS=600

# Live stream edit update interval in milliseconds (default: 1500ms)
# Keeps updates smooth while staying well within Telegram's rate limits
STREAM_EDIT_INTERVAL_MS=1500

# Shell executor: "auto", "powershell", "cmd", "sh", "bash"
# "auto" uses powershell/cmd on Windows, and /bin/sh on Linux/macOS
SHELL_TYPE=auto

# Local control IPC server port (default: 47999)
CONTROL_PORT=47999
